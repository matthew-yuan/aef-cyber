[
  {"id": "soc", "type": "deploy_env", "env_id": "soc", "sandbox_type": "local", "depends_on": []},
  {"id": "seed", "type": "load_artifact", "env_id": "soc", "artifact_id": "soc-sample", "depends_on": [{"task_step_id": "soc"}]},
  {"id": "submit", "type": "run_code", "env_id": "soc", "script_artifact_id": "soc_ops", "args": {"set": "golden"},
   "depends_on": [{"task_step_id": "seed"}]},
  {"id": "snap-final", "type": "snapshot_env", "env_id": "soc", "snapshot_id": "scorebox-smoke-final", "depends_on": [{"task_step_id": "submit"}]},
  {"id": "scorebox-vm", "type": "deploy_sandbox", "sandbox_name": "scorebox", "sandbox_mode": "vm", "ttl_seconds": 1800, "depends_on": []},
  {"id": "scorebox-ctr", "type": "run_docker_container", "sandbox_name": "scorebox", "docker_context_artifact_id": "scorebox_context",
   "container_name": "scorebox", "network": "none", "env_vars": {}, "depends_on": [{"task_step_id": "scorebox-vm"}]},
  {"id": "handoff", "type": "load_artifact", "sandbox_name": "scorebox", "container_name": "scorebox", "artifact_from_step_id": "snap-final",
   "destination_path": "/handoff", "depends_on": [{"task_step_id": "snap-final"}, {"task_step_id": "scorebox-ctr"}]},
  {"id": "exec-tests", "type": "run_container_unit_tests_verifier", "verifier_id": "exec-tests", "sandbox_name": "scorebox", "container_name": "scorebox",
   "user": "runner", "command": "python3 -I /harness/run_tests.py --handoff /handoff --data /harness/data --out /work/out --work /work/runs",
   "timeout_sec": 300, "env_vars": {"LITELLM_API_KEY": "", "ANTHROPIC_API_KEY": "", "LITELLM_BASE_URL": "", "ANTHROPIC_BASE_URL": "", "LITELLM_EXTRA_HEADERS": "{}"},
   "result_paths": ["/work/out/results.json"], "reward_path": "/work/out/reward.txt", "depends_on": [{"task_step_id": "handoff"}]}
]
